{
  "name": "@annex/cli",
  "version": "0.1.0",
  "description": "Annex CLI — scan a codebase for EU AI Act conformity, generate the Annex IV dossier, and close the gaps.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "annex": "./dist/bin.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/bin.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@annex/engine": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": { "node": ">=20.11" }
}
