            {
              "id": "colorado-admt.pre-use-notice",
              "name": "ColoradoAdmtPreUseNotice",
              "shortDescription": {
                "text": "Clear pre-use notice before a consequential decision"
              },
              "fullDescription": {
                "text": "A deployer must give clear and conspicuous notice, before the consequential decision, that covered automated decision-making technology is or will be used — accessible to consumers with disabilities and with limited English proficiency."
              },
              "help": {
                "text": "A deployer must give clear and conspicuous notice, before the consequential decision, that covered automated decision-making technology is or will be used — accessible to consumers with disabilities and with limited English proficiency.\n\nShow the notice before the decision is made, not in a policy page the consumer never opens, and provide it in an accessible form.\n\nColorado ADMT Act § 6-1-1703 — Deployer duties — pre-use notice: https://leg.colorado.gov/bills/sb26-189",
                "markdown": "**Clear pre-use notice before a consequential decision**\nA deployer must give clear and conspicuous notice, before the consequential decision, that covered automated decision-making technology is or will be used — accessible to consumers with disabilities and with limited English proficiency.\n**How to close it:** Show the notice before the decision is made, not in a policy page the consumer never opens, and provide it in an accessible form.\n**Citations**\n- [Colorado ADMT Act § 6-1-1703 — Deployer duties — pre-use notice](https://leg.colorado.gov/bills/sb26-189)\n_In force from 2027-01-01._"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
